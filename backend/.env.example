ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://dental_user:dental_password@localhost:5433/dental_db
ALEMBIC_DATABASE_URL=postgresql+psycopg://dental_user:dental_password@localhost:5433/dental_db
TEST_DATABASE_URL=postgresql+psycopg://dental_user:dental_password@localhost:5433/dental_app_test
SECRET_KEY=replace-with-a-secure-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CHECK_IN_QR_EXPIRE_MINUTES=180
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_ENABLED=true
TRUSTED_PROXY_HOPS=0
# On Render Secret Files, set FIREBASE_CREDENTIALS_PATH=/etc/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json
